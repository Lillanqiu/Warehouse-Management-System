def person_name_from_file_name(file_name):
    text = clean_docx_text(file_name).replace("\\", "/")
    base = text.split("/")[-1] if text else ""
    base = re.sub(r"\.[^.\\/]+$", "", base)
    base = re.sub(r"[锛?][^锛?]*[锛?]", " ", base)
    base = re.sub(r"\b20\d{2}[.\-_/骞碷\d{1,2}(?:[.\-_/鏈圿\d{1,2})?鏃?\b", " ", base)
    parts = [clean_docx_text(item) for item in re.split(r"[-鈥擾]+", base) if clean_docx_text(item)]
    candidates = []
    for part in parts or [base]:
        if "璧勪骇" in part:
            candidates.append(part.split("璧勪骇", 1)[0])
        if "鑰楁潗" in part:
            candidates.append(part.split("鑰楁潗", 1)[0])
        candidates.append(part)
    for candidate in candidates:
        clean = clean_docx_text(candidate).strip(" -鈥擾锛?锛堬級()[]銆愩€?)
        clean = re.sub(r"(浜哄憳)?(璧勪骇|鑰楁潗)(浣跨敤|棰嗙敤)?(琛▅娓呭崟)?$", "", clean)
        clean = re.sub(r"(椤圭洰鍐??绯荤粺娓呯偣$", "", clean)
        clean = re.sub(r"(娓呯偣|鐩樼偣|娓呭崟|琛ㄦ牸|琛?$", "", clean)
        clean = normalize_import_owner_name(clean)
        if not clean:
            continue
        if field_key(clean) in {field_key(item) for item in GENERIC_FILE_OWNER_TOKENS}:
            continue
        if re.fullmatch(r"\d+", clean):
            continue
        return clean
    return ""


