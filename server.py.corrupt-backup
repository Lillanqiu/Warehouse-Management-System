def normalize_header_key(value):
    text = field_key(value).strip(":锛?)
    return re.sub(r"[锛堬級()\[\]銆愩€?>銆娿€?锛?锛屻€?\\|_\-]", "", text).lower()


def aliases_for_field(name):
    aliases = [name]
    key = field_key(name).strip(":锛?)
    aliases.extend(FIELD_ALIASES.get(key, ()))
    normalized = normalize_header_key(name)
    for canonical, values in FIELD_ALIASES.items():
        if normalize_header_key(canonical) == normalized or normalized in {normalize_header_key(item) for item in values}:
            aliases.append(canonical)
            aliases.extend(values)
    result = []
    seen = set()
    for alias in aliases:
        alias_key = normalize_header_key(alias)
        if alias_key and alias_key not in seen:
            result.append(alias)
            seen.add(alias_key)
    return result


def header_matches_alias(header, alias):
    header_key = normalize_header_key(header)
    alias_key = normalize_header_key(alias)
    if not header_key or not alias_key:
        return False
    if header_key == alias_key:
        return True
    # Long aliases safely cover headers with prefixes/suffixes, such as "4鏈?2鏃ユ竻鏌ョ洏鐐规儏鍐?.
    return len(alias_key) >= 4 and (alias_key in header_key or header_key in alias_key)


def header_matches_field(header, field_name):
    return any(header_matches_alias(header, alias) for alias in aliases_for_field(field_name))


def table_header_score(row):
    marker_fields = ("璧勪骇缂栧彿", "璧勪骇鍚嶇О", "瑙勬牸鍨嬪彿", "璧勪骇鍒嗙被", "鏁伴噺", "閮ㄩ棬", "鍏蜂綋瀛樻斁鍦扮偣", "璧勪骇鍘熷€?, "鍙栧緱鏃ユ湡")
    score = 0
    for field_name in marker_fields:
        if any(header_matches_field(cell, field_name) for cell in row):
            score += 1
    return score


def table_to_dicts(rows):
    if not rows:
        return []
    header_index = 0
    for index, row in enumerate(rows[:30]):
        if table_header_score(row) >= 2:
            header_index = index
            break
    headers = [str(item).strip().replace("\n", "") for item in rows[header_index]]
    result = []
    for row in rows[header_index + 1:]:
        item = {}
        for index, header in enumerate(headers):
            if header:
                item[header] = str(row[index]).strip() if index < len(row) else ""
        if any(item.values()):
            result.append(item)
    return result


def table_to_dicts_with_row_numbers(rows):
    if not rows:
        return []
    header_index = 0
    for index, item in enumerate(rows[:30]):
        row = item["values"]
        if table_header_score(row) >= 2:
            header_index = index
            break
    headers = [str(item).strip().replace("\n", "") for item in rows[header_index]["values"]]
    result = []
    for row_item in rows[header_index + 1:]:
        item = {"__row_number": row_item["row_number"]}
        for index, header in enumerate(headers):
            if header:
                item[header] = str(row_item["values"][index]).strip() if index < len(row_item["values"]) else ""
        if any(value for key, value in item.items() if not key.startswith("__")):
            result.append(item)
    return result


def first_value(row, names):
    if not isinstance(row, dict):
        return ""
    for name in names:
        for alias in aliases_for_field(name):
            direct = row.get(alias)
            if direct:
                return str(direct).strip()
            for header, value in row.items():
                if value and header_matches_alias(header, alias):
                    return str(value).strip()
    return ""


def first_exact_value(row, names):
    if not isinstance(row, dict):
        return ""
    alias_keys = []
    seen = set()
    for name in names:
        for alias in aliases_for_field(name):
            alias_key = normalize_header_key(alias)
            if alias_key and alias_key not in seen:
                alias_keys.append((alias, alias_key))
                seen.add(alias_key)
    for alias, _ in alias_keys:
        direct = row.get(alias)
        if direct:
            return str(direct).strip()
    for header, value in row.items():
        if not value:
            continue
        header_key = normalize_header_key(header)
        if any(header_key == alias_key for _, alias_key in alias_keys):
            return str(value).strip()
    return ""


