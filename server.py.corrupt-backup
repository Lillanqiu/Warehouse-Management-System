def deactivate_imported_non_person_users(conn, actor, users, skip_admin=True, skip_referenced=False):
    updated = []
    skipped = []
    actor_id = actor["id"]
    for item in users:
        if item["role_id"] == "admin" and skip_admin:
            skipped.append({**item, "reason": "管理员账号已跳过"})
            continue
        if skip_referenced:
            refs = item.get("referenceCounts") or {}
            if int(refs.get("recordsCount") or 0) > 0 or int(refs.get("keeperAssetsCount") or 0) > 0 or int(
                refs.get("useUserAssetsCount") or 0
            ) > 0:
                skipped.append({**item, "reason": "有关联资产/记录，已跳过"})
                continue
        if item["id"] == actor_id:
            skipped.append({**item, "reason": "当前会话账号已跳过"})
            continue
        if not item["active"]:
            skipped.append({**item, "reason": "账号已停用"})
            continue
        conn.execute("update users set active = 0 where id = ?", (item["id"],))
        updated.append({**item, "reason": "已停用"})
    if updated:
        add_audit(
            conn,
            actor_id,
            "重检导入用户并停用",
            f"本次清理了 {len(updated)} 条导入异常用户",
        )
    return updated, skipped


