    return next((name for item_id, name, _ in ROLE_DEFINITIONS if item_id == role_id), role_id or "鏅€氭暀甯?)


def user_permissions(conn, user):
    role_id = role_id_for_user(user)
    rows = rows_to_list(
        conn.execute(
            "select permission_code from role_permissions where role_id = ?",
            (role_id,),
        )
    )
    return {item["permission_code"] for item in rows}


def user_menus(conn, user):
    role_id = role_id_for_user(user)
    rows = rows_to_list(
        conn.execute(
            """
            select rm.menu_key
            from role_menus rm
            join menu_permissions mp on mp.menu_key = rm.menu_key and mp.active = 1
            where rm.role_id = ?
            order by case rm.menu_key
              when 'dashboard' then 1 when 'assets' then 2 when 'records' then 3
              when 'checks' then 4 when 'orders' then 5 when 'reports' then 6
              when 'assetRequests' then 7 when 'purchaseWishes' then 8
              when 'paper' then 9 when 'users' then 10 when 'baseData' then 11
              when 'settings' then 12 when 'audit' then 13 else 99 end
            """,
            (role_id,),
        )
    )
    return [item["menu_key"] for item in rows]


