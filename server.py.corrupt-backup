    if marker and marker["value"] == "1":
        return
    records = rows_to_list(
        conn.execute(
            """
            select r.*, a.id as asset_id, a.quantity as asset_quantity, a.status as asset_status,
                   u.name as user_name
            from records r
            join assets a on a.id = r.asset_id
            left join users u on u.id = r.user_id
            where r.type = '鍑哄簱'
              and (a.code like 'IMPORT-%' or a.code like 'CONSUMABLE-%' or a.code = '' or a.code is null)
            order by r.id
            """
        )
    )
    delete_ids = []
    touched_assets = set()
    restored_quantity = 0
    for record in records:
        file_names = import_file_names_from_note(record["note"])
        if not file_names:
            continue
        file_has_person = any(import_owner_looks_like_person(person_name_from_file_name(file_name)) for file_name in file_names)
