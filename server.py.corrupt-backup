def xlsx_sheet_rows(archive, sheet_name, shared_strings):
    rows = []
    root = ElementTree.fromstring(archive.read(sheet_name))
    for row in root.findall(".//{http://schemas.openxmlformats.org/spreadsheetml/2006/main}row"):
        values = []
        for cell in row.findall("{http://schemas.openxmlformats.org/spreadsheetml/2006/main}c"):
            index = cell_index(cell)
            if index is None:
                index = len(values)
            while len(values) <= index:
                values.append("")
            values[index] = cell_text(cell, shared_strings)
        if any(values):
            rows.append(values)
    return rows


def xlsx_sheet_rows_with_numbers(archive, sheet_name, shared_strings):
    rows = []
    root = ElementTree.fromstring(archive.read(sheet_name))
    fallback_row_number = 1
    for row in root.findall(".//{http://schemas.openxmlformats.org/spreadsheetml/2006/main}row"):
        values = []
        row_number = int(row.attrib.get("r") or fallback_row_number)
        fallback_row_number = row_number + 1
        for cell in row.findall("{http://schemas.openxmlformats.org/spreadsheetml/2006/main}c"):
            index = cell_index(cell)
            if index is None:
                index = len(values)
            while len(values) <= index:
                values.append("")
            values[index] = cell_text(cell, shared_strings)
        if any(values):
            rows.append({"row_number": row_number, "values": values})
    return rows


def xml_local_name(tag):
    return str(tag).split("}", 1)[-1]


def normalize_zip_target(base_path, target):
    target = str(target or "").replace("\\", "/")
    if not target:
        return ""
    if target.startswith("/"):
        target = target[1:]
    base_parts = base_path.split("/")[:-1]
    parts = []
    for part in [*base_parts, *target.split("/")]:
        if not part or part == ".":
            continue
        if part == "..":
            if parts:
                parts.pop()
            continue
        parts.append(part)
    return "/".join(parts)


def package_relationships(archive, rels_path, base_path):
    if rels_path not in archive.namelist():
        return {}
    root = ElementTree.fromstring(archive.read(rels_path))
    relationships = {}
    for rel in root:
        if xml_local_name(rel.tag) != "Relationship":
            continue
        rel_id = rel.attrib.get("Id")
        target = rel.attrib.get("Target")
        if rel_id and target:
            relationships[rel_id] = normalize_zip_target(base_path, target)
    return relationships


def xlsx_rels_path(part_path):
    directory, file_name = part_path.rsplit("/", 1)
    return f"{directory}/_rels/{file_name}.rels"


def image_mime_from_name(name):
    lower = str(name or "").lower()
    if lower.endswith((".jpg", ".jpeg")):
        return "image/jpeg"
    if lower.endswith(".png"):
        return "image/png"
    if lower.endswith(".gif"):
        return "image/gif"
    if lower.endswith(".webp"):
        return "image/webp"
    return ""


def image_data_url_from_bytes(file_name, content):
    mime = image_mime_from_name(file_name)
    if not mime:
        return ""
    if len(content or b"") > 5 * 1024 * 1024:
        return ""
    return f"data:{mime};base64,{base64.b64encode(content).decode('ascii')}"


def xlsx_sheet_images_by_row(archive, sheet_name):
    sheet_xml = ElementTree.fromstring(archive.read(sheet_name))
    sheet_rels = package_relationships(archive, xlsx_rels_path(sheet_name), sheet_name)
    drawings = []
    for node in sheet_xml.iter():
        if xml_local_name(node.tag) != "drawing":
            continue
        rel_id = node.attrib.get("{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id")
        drawing_path = sheet_rels.get(rel_id)
        if drawing_path:
            drawings.append(drawing_path)
    row_images = {}
    for drawing_path in drawings:
        if drawing_path not in archive.namelist():
            continue
        drawing_rels = package_relationships(archive, xlsx_rels_path(drawing_path), drawing_path)
        drawing_root = ElementTree.fromstring(archive.read(drawing_path))
        for anchor in drawing_root:
            if xml_local_name(anchor.tag) not in ("twoCellAnchor", "oneCellAnchor"):
                continue
            from_node = next((child for child in anchor if xml_local_name(child.tag) == "from"), None)
            row_node = next((child for child in list(from_node or []) if xml_local_name(child.tag) == "row"), None)
            if row_node is None or row_node.text is None:
                continue
            try:
                row_number = int(row_node.text) + 1
            except ValueError:
                continue
            embed_id = ""
            for child in anchor.iter():
                if xml_local_name(child.tag) == "blip":
                    embed_id = child.attrib.get("{http://schemas.openxmlformats.org/officeDocument/2006/relationships}embed", "")
                    if embed_id:
                        break
            image_path = drawing_rels.get(embed_id)
            if not image_path or image_path not in archive.namelist():
                continue
            data_url = image_data_url_from_bytes(image_path, archive.read(image_path))
            if data_url:
                row_images.setdefault(row_number, []).append(data_url)
    return row_images


