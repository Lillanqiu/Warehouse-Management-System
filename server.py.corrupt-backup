def find_consumable_asset(conn, row):
    asset = find_asset(conn, row)
    if asset and is_consumable_asset(asset):
        return asset
    name = first_value(row, ("鑰楁潗鍚嶇О", "璧勪骇鍚嶇О", "鍚嶇О", "鐗╁搧鍚嶇О", "asset_name", "name"))
    spec = first_value(row, ("瑙勬牸鍨嬪彿", "瑙勬牸", "鍨嬪彿", "spec"))
    keys = [compact_match_key(value) for value in (name, spec) if compact_match_key(value)]
    if not keys:
        return None
    candidates = rows_to_list(conn.execute("select * from assets where code like 'CONSUMABLE-%' or code like 'IMPORT-%' or code = '' or code is null"))
    exact_matches = []
    fuzzy_matches = []
    scored_matches = []
    class_terms = ("榧犳爣", "閿洏", "纭洏", "鍥烘€?, "ssd", "m.2", "m2", "nvme", "鍐呭瓨", "缃戝崱", "鐢垫簮", "鐢垫睜", "缃戠嚎", "鐢垫簮绾?, "console绾?, "璋冭瘯绾?, "杞帴", "杞崲", "鎵╁睍鍧?, "鎷撳睍鍧?, "璇濈瓛", "鎵╅煶鍣?, "鏂囦欢琚?, "鎺掓彃")
    storage_terms = ("纭洏", "鍥烘€?, "ssd", "m.2", "m2", "nvme", "970", "980", "990", "750")
    storage_haystack_terms = ("纭洏", "鍥烘€?, "ssd", "m.2", "nvme")
    key_text = compact_match_key(" ".join([name or "", spec or ""]))
    key_is_storage = any(compact_match_key(term) in key_text for term in storage_terms)
    for candidate in candidates:
        if not is_consumable_asset(candidate):
            continue
        candidate_name = compact_match_key(candidate["name"])
        candidate_spec = compact_match_key(candidate["spec"])
        haystack = compact_match_key(" ".join([candidate["name"] or "", candidate["spec"] or "", candidate["category"] or ""]))
        if any(key and key in (candidate_name, candidate_spec) for key in keys):
            exact_matches.append(candidate)
            continue
        if any(key and (key in haystack or haystack in key) for key in keys):
            fuzzy_matches.append(candidate)
            continue
        score = 0
        for term in class_terms:
            term_key = compact_match_key(term)
            if term_key and term_key in key_text and term_key in haystack:
                score += 10
        if "dell" in key_text or "鎴村皵" in key_text:
            if "dell" in haystack or "鎴村皵" in haystack:
                score += 6
        if "涓夋槦" in key_text and "涓夋槦" in haystack:
            score += 6
        if key_is_storage and any(compact_match_key(term) in haystack for term in storage_haystack_terms):
            score += 10
        if "榧犳爣" in key_text and "榧犳爣" not in haystack:
            score -= 20
        if "閿洏" in key_text:
            if "閿洏" not in haystack:
                score -= 20
            if "鎵嬫墭" in haystack and "鎵嬫墭" not in key_text:
                score -= 12
        if key_is_storage and not any(compact_match_key(term) in haystack for term in storage_haystack_terms):
            score -= 20
        if score > 0:
            if int(candidate["quantity"] or 0) > 0:
                score += 2
            scored_matches.append((score, candidate))
    ranked_matches = [(100, item) for item in exact_matches] + [(60, item) for item in fuzzy_matches] + scored_matches
    if ranked_matches:
        available = [item for item in ranked_matches if int(item[1]["quantity"] or 0) > 0]
        pool = available or ranked_matches
        return sorted(pool, key=lambda item: (-item[0], -int(item[1]["quantity"] or 0), str(item[1]["name"] or "")))[0][1]
    return None


def number_value(value, default=1):
    text = str(value or "").strip()
    if not text:
        return default
    match = re.search(r"-?\d+(?:\.\d+)?", text.replace(",", ""))
    if not match:
        return default
    return int(float(match.group(0)))


