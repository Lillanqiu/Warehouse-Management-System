            update_asset_fields(
                conn,
                asset_id,
                {"status": "in_stock"},
                "u-admin",
                "cleanup_import",
                source_type="migration",
                source_id="cleanup_non_person_consumable_usage_v145",
                note="娓呯悊闈炰汉鍛樿€楁潗璁板綍鍚庢仮澶嶅湪搴撶姸鎬?,
            )
    if delete_ids or restored_quantity:
        add_audit(conn, "u-admin", "娓呯悊闈炰汉鍛樿€楁潗棰嗙敤", f"娓呯悊闈炰汉鍛樻竻鐐规枃浠跺嚭搴?{len(delete_ids)} 鏉★紝鎭㈠鑰楁潗搴撳瓨 {restored_quantity} 浠?)
