def import_person_consumable_rows(conn, actor, rows, file_name, file_hash, row_scope="person-consumables-v145", fallback_user_name=""):
    imported = 0
    duplicate_rows = 0
    skipped = []
    record_ids = []
    for index, source_row in enumerate(rows, start=2):
        source_index = int(source_row.get("__import_row_number") or index) if isinstance(source_row, dict) else index
        row = attach_import_user_fallback(source_row, fallback_user_name)
        row_hash = import_row_hash(row, row_scope)
        previous_row = imported_row(conn, row_hash)
        if previous_row:
            duplicate_rows += 1
            continue
        asset = find_consumable_asset(conn, row)
        if not asset:
            skipped.append({"row": source_index, "reason": "鎵句笉鍒拌€楁潗锛岃妫€鏌ヨ€楁潗鍚嶇О銆佽鏍煎瀷鍙锋垨璧勪骇缂栧彿"})
            continue
        if not is_consumable_asset(asset):
            skipped.append({"row": source_index, "reason": f"{asset['name']} 涓嶆槸鑰楁潗锛屼笉鑳芥寜鑰楁潗棰嗙敤琛ㄦ墸搴?})
            continue
        if not is_probable_person_name(person_name_from_row(row)):
            skipped.append({"row": source_index, "reason": f"鎵句笉鍒颁娇鐢ㄤ汉锛氳鍦ㄨ〃鏍煎鍔犻鐢ㄤ汉/浣跨敤浜?濮撳悕鍒楋紝鎴栫敤鈥滃鍚嶈€楁潗.xlsx鈥濈殑鏂瑰紡鍛藉悕鏂囦欢锛涜В鏋愬埌鏂囦欢鍚嶄汉鍛橈細{fallback_user_name or '-'}"})
            continue
        user = ensure_import_user(conn, row, actor)
        try:
            quantity = max(1, number_value(first_value(row, ("鏁伴噺", "棰嗙敤鏁伴噺", "qty", "quantity")), default=1))
        except ValueError:
            skipped.append({"row": source_index, "reason": "鏁伴噺鏍煎紡涓嶆纭?})
            continue
        existing_record = conn.execute(
            """
            select id
            from records
            where asset_id = ?
              and type = '鍑哄簱'
              and user_id = ?
              and quantity = ?
              and note like ?
            limit 1
            """,
            (asset["id"], user["id"], quantity, f"%浜哄憳鑰楁潗棰嗙敤琛ㄥ鍏ワ細{file_name}%"),
        ).fetchone()
        if existing_record:
            duplicate_rows += 1
            register_import_row(conn, file_hash, row_hash, file_name, source_index, "record", existing_record["id"], "duplicate", actor["id"])
            continue
        current_quantity = int(asset["quantity"] or 0)
        if current_quantity < quantity:
            skipped.append({"row": source_index, "reason": f"搴撳瓨涓嶈冻锛氬綋鍓?{current_quantity}锛岄鐢?{quantity}"})
            continue
        out_time = normalize_time(first_value(row, ("鍑哄簱鏃堕棿", "棰嗙敤鏃堕棿", "棰嗙敤鏃ユ湡", "out_time"))) or now_local()
        paper_no = first_value(row, ("绾歌川鍗曞彿", "鍗曞彿", "paper_no"))
        row_note = first_value(row, ("澶囨敞", "鐢ㄩ€?, "note"))
        record_id = new_id("record")
        conn.execute(
            "insert into records (id, asset_id, type, quantity, user_id, operator_id, in_time, out_time, status, paper_no, note, photo) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (
                record_id,
                asset["id"],
                "鍑哄簱",
                quantity,
                user["id"],
                actor["id"],
                "",
                out_time,
                "浣跨敤涓?,
                paper_no,
                append_unique_note(row_note, f"浜哄憳鑰楁潗棰嗙敤琛ㄥ鍏ワ細{file_name}"),
                "",
            ),
        )
        next_quantity = max(0, current_quantity - quantity)
        try:
            update_asset_fields(
                conn,
                asset["id"],
                {
                    "quantity": next_quantity,
                    "status": "in_stock" if next_quantity > 0 else "checked_out",
                    "keeper_id": user["id"],
                    "use_user_id": user["id"],
                    "use_department": user["department"],
                },
                actor["id"],
                "stock_adjust",
                business_no=paper_no,
                source_type="record",
                source_id=record_id,
                note="浜哄憳鑰楁潗棰嗙敤琛ㄥ鍏ユ墸鍑忓簱瀛?,
            )
        except ValueError as exc:
            conn.execute("delete from records where id = ?", (record_id,))
            skipped.append({"row": source_index, "reason": str(exc)})
            continue
        imported += 1
        record_ids.append(record_id)
        register_import_row(conn, file_hash, row_hash, file_name, source_index, "record", record_id, "imported", actor["id"])
    return ensure_import_result_stats({
        "imported": imported,
        "createdAssets": 0,
        "existingAssets": 0,
        "updatedAssets": 0,
        "processedRows": imported + len(skipped),
        "duplicateRows": duplicate_rows,
        "duplicateFiles": 0,
        "skipped": skipped,
        "_recordIds": record_ids,
    })


