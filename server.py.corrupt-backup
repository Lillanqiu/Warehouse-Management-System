def image_mime_from_bytes(content):
    content = content or b""
    if content.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if content.startswith(b"\xff\xd8"):
        return "image/jpeg"
    if content.startswith((b"GIF87a", b"GIF89a")):
        return "image/gif"
    if content.startswith(b"RIFF") and content[8:12] == b"WEBP":
        return "image/webp"
    return ""


def normalize_image_reference(value):
    text = clean_docx_text(value)
    if not text:
        return ""
    hyperlink = re.search(r'HYPERLINK\(\s*"([^"]+)"', text, re.IGNORECASE)
    if hyperlink:
        text = hyperlink.group(1)
    url = re.search(r"https?://[^\s,锛?锛?锛塢+", text)
    if url:
        text = url.group(0)
    if text.startswith("data:image/") or re.match(r"^https?://", text):
        return valid_login_background(text)
    compact = re.sub(r"\s+", "", text)
    if len(compact) > 80:
        try:
            raw = base64.b64decode(compact, validate=True)
        except (ValueError, binascii.Error):
            raw = b""
        mime = image_mime_from_bytes(raw)
        if mime:
            return valid_login_background(f"data:{mime};base64,{base64.b64encode(raw).decode('ascii')}")
    return ""


def asset_reference_image_value(row):
    embedded = row.get("__embedded_image", "") if isinstance(row, dict) else ""
    if embedded:
