            meaningful = [
                cell for cell in cells
                if cell
                and cell not in serial_values
                and cell != "1"
                and not is_invalid_field_value(cell)
                and not all(label in cell for label in ("鍥哄畾璧勪骇", "浣庡€兼槗鑰楀搧", "鑰楁潗", "璐繘杞欢"))
