    is_consumable = is_consumable_asset(item)
    is_software = ("杞欢" in category or "璐繘杞欢" in category) and not template_noise
    is_low_value = ("浣庡€兼槗鑰楀搧" in category or "鏄撹€楀搧" in category) and not template_noise
    is_fixed = "鍥哄畾璧勪骇" in text or (not is_consumable and not is_software and not is_low_value)
    return {
