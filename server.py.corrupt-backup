def is_blank_requisition_template(parsed):
    if not detect_document_type(parsed.get("text", "")):
        return False
    invalid_labels = {"鐢宠缂樼敱", "棰嗙敤鏃ユ湡", "褰掕繕鏃ユ湡", "椤圭洰璐熻矗浜哄鏍?, "璧勪骇绠＄悊璐熻矗浜哄鏍?, "澶囨敞", "棰嗙敤浜虹‘璁?, "褰掕繕纭"}
    serial_values = {str(index) for index in range(1, 16)}
    for table in parsed.get("tables", []):
        header_index = None
        for index, row in enumerate(table):
            joined = "".join(row)
            if "鐗╁搧鍚嶇О" in joined and "鏁伴噺" in joined:
                header_index = index
                break
        if header_index is None:
            continue
        for row in table[header_index + 1:]:
            cells = [clean_docx_text(cell) for cell in row]
            row_text = "".join(cells)
            if not row_text:
                continue
            if any(label in row_text for label in invalid_labels):
