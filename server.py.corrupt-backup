def record_document_type(note):
    text = str(note or "")
    for part in str(note or "").split("锛?):
        clean = clean_docx_text(part)
        if clean.startswith("鍗曟嵁绫诲瀷锛?):
            return clean.split("锛?, 1)[1].strip()
    if "鑰楁潗" in text:
        return "鑰楁潗棰嗙敤"
    if "Word棰嗙敤鍗曞鍏? in text:
        return "璧勪骇棰嗙敤"
    return ""


def record_display_note(note):
    hidden_prefixes = (
        "妯℃澘搴忓彿锛?,
        "Word棰嗙敤鍗曞鍏?,
        "鍑哄€熶汉锛?,
        "瀵煎叆鏂囦欢锛?,
        "瀵煎叆鏃堕棿锛?,
        "鍗曞彿锛?,
        "鍗曟嵁绫诲瀷锛?,
        "璐熻矗浜猴細",
        "鐢宠浜猴細",
    )
    parts = []
    for part in str(note or "").split("锛?):
        clean = clean_docx_text(part)
        if not clean:
            continue
        if any(clean.startswith(prefix) for prefix in hidden_prefixes):
            continue
        parts.append(clean)
    return "锛?.join(parts)


